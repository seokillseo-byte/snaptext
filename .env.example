NODE_ENV=development
API_PORT=3001
WEB_PORT=5173
DATABASE_URL=postgresql://snaptext:snaptext@localhost:5432/snaptext
DB_POOL_MAX=10
# Resend transactional email; leave blank to keep email delivery fail-closed.
# Create the API key in Resend and use a sender address from a verified domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Set to the number of trusted reverse-proxy hops in production; keep 0 for direct local access.
TRUST_PROXY_HOPS=0
STORAGE_ROOT=.snaptext-data/images
UPLOAD_TEMP_ROOT=.snaptext-data/tmp
UPLOAD_MAX_FILES=20
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_MAX_TOTAL_SIZE_MB=100
AI_FALLBACK_ENABLED=false
AI_DAILY_BUDGET_USD=0
